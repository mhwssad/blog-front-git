# 环境变量说明
# VITE_APP_NAME - 应用名称
# VITE_APP_VERSION - 应用版本
# VITE_API_BASE_URL - 前端请求前缀，当前项目固定为 /api
# VITE_ENABLE_MOCK - 是否启用本地 Mock，当前项目默认全部使用 Mock
# VITE_DEV_PROXY_TARGET - 关闭 Mock 后转发的后端地址
# VITE_ENABLE_DEV_TOOLS - 是否启用开发工具
# VITE_LOG_LEVEL - 日志级别，可选 debug/info/warn/error/silent
# VITE_LOG_BUFFER_SIZE - 前端内存日志缓存条数
# VITE_ENABLE_LOG_PERSISTENCE - 是否持久化到 sessionStorage
#
# 当前推荐配置：
# VITE_API_BASE_URL=/api
# VITE_ENABLE_MOCK=true
# VITE_LOG_LEVEL=debug
# VITE_LOG_BUFFER_SIZE=200
# VITE_ENABLE_LOG_PERSISTENCE=false
