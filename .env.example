# 环境变量说明

# ── API ──────────────────────────────────────────────
VITE_API_BASE_URL=/api                    # API 请求前缀
VITE_ENABLE_MOCK=true                     # 是否启用本地 Mock
VITE_DEV_PROXY_TARGET=localhost:8080      # 后端 host:port（用于 WebSocket 和 Proxy）

# ── 日志 ─────────────────────────────────────────────
VITE_LOG_LEVEL=debug                      # 日志级别: debug/info/warn/error/silent
VITE_LOG_BUFFER_SIZE=200                  # 前端内存日志缓存条数
VITE_ENABLE_LOG_PERSISTENCE=false         # 是否持久化到 sessionStorage

# ── 三套环境 ─────────────────────────────────────────
#
# 开发环境 (.env.development)：
#   pnpm dev
#   - 启用 Mock，无需后端
#   - 日志级别 debug
#
# 联调环境 (.env.staging)：
#   pnpm dev:staging          # 本地启动，连接测试后端
#   pnpm build:staging        # 构建测试包
#   - 关闭 Mock，直连后端
#   - 日志级别 info
#
# 生产环境 (.env.production)：
#   pnpm build
#   - 关闭 Mock
#   - 日志级别 error
