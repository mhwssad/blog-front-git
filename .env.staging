# 测试环境配置

# 应用名称
VITE_APP_NAME=Blog Front

# 应用版本
VITE_APP_VERSION=1.0.0

# API 基础 URL（直连后端，后端已配置 CORS）
VITE_API_BASE_URL=http://localhost:8080/api

# 测试环境关闭 Mock，使用真实后端
VITE_ENABLE_MOCK=false

# 不走 proxy，留空即可
VITE_DEV_PROXY_TARGET=

# 是否启用开发工具
VITE_ENABLE_DEV_TOOLS=true

# 日志级别
VITE_LOG_LEVEL=info

# 日志缓存条数
VITE_LOG_BUFFER_SIZE=150

# 是否持久化日志
VITE_ENABLE_LOG_PERSISTENCE=false
